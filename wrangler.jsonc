{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "astro-emdash-dev-repro",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "astro-emdash-dev-repro",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "astro-emdash-dev-repro-media",
		},
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	// General maintenance plus the bounded Media Usage lane (see src/worker.ts)
	"triggers": {
		"crons": ["* * * * *", "*/2 * * * *"],
	},
}
